# ═══════════════════════════════════════════
# TravelBlog Pro v1.0 환경변수 설정
# 이 파일을 .env로 복사 후 실제 값을 입력하세요
# ═══════════════════════════════════════════

# ─── OpenAI (필수) ───
OPENAI_API_KEY=sk-여기에_실제_API키_입력
OPENAI_MODEL=gpt-4o-mini

# ─── 네이버 블로그 ───
NAVER_ENABLED=true
NAVER_USERNAME=여기에_네이버_아이디
NAVER_PASSWORD=여기에_네이버_비밀번호

# ─── 티스토리 (카카오 로그인) ───
TISTORY_ENABLED=false
TISTORY_BLOG_NAME=
KAKAO_EMAIL=
KAKAO_PASSWORD=
